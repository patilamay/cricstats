{
  "name": "cricstats",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Cricket statistics site built from Cricsheet ball-by-ball data, refreshed daily.",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/spa-fallback.js",
    "preview": "vite preview",
    "data": "node pipeline/build.js",
    "data:sample": "node pipeline/sample/make-sample.js .cache/sample && node pipeline/build.js --local .cache/sample",
    "test": "node --test \"pipeline/test/*.test.js\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "vite": "^5.4.21"
  }
}
