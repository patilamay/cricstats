{
  "name": "cricstats",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Cricket statistics site built from Cricsheet ball-by-ball data, refreshed daily.",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/spa-fallback.js",
    "preview": "vite preview",
    "data": "node pipeline/build.js",
    "data:sample": "node pipeline/sample/make-sample.js .cache/sample && node pipeline/build.js --local .cache/sample --wiki-local .cache/sample/_wiki --history-local .cache/sample/_wiki/history.json",
    "test": "node --test pipeline/test/parse.test.js pipeline/test/infobox.test.js pipeline/test/careers.test.js pipeline/test/matchbox.test.js",
    "db": "node pipeline/build.js --export .cache/export && python3 pipeline/make_db.py .cache/export db"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fontsource/figtree": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "vite": "^5.4.21"
  }
}
